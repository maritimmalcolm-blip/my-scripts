                    and player.PlayerGui.DuelsMachineTopFrame.DuelsMachineTopFrame
                    :FindFirstChild("Timer")
                    and player.PlayerGui.DuelsMachineTopFrame.DuelsMachineTopFrame.Timer
                    :FindFirstChild("Label")
