-- ========== CREATE DRAGGABLE BUTTON ==========
local function createDraggableButton(name, text, yPos, color, hasDot)
    local gui = Instance.new("ScreenGui")
    gui.Name = name .. "Button"
    gui.Parent = player:WaitForChild("PlayerGui")
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    
    local btn = Instance.new("ImageButton")
    btn.Size = UDim2.new(0, 140, 0, 50)
    btn.Position = UDim2.new(0, 20, 0, yPos)
    btn.BackgroundColor3 = color or Color3.fromRGB(128, 0, 255)
    btn.BackgroundTransparency = 0
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = gui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = btn
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Thickness = 1.5
    stroke.Transparency = 0.3
    stroke.Parent = btn
    
    local btnText = Instance.new("TextLabel")
    btnText.Size = UDim2.new(1, 0, 1, 0)
    btnText.BackgroundTransparency = 1
    btnText.Text = text
    btnText.TextColor3 = Color3.fromRGB(255, 255, 255)
    btnText.TextSize = 14
    btnText.Font = Enum.Font.GothamBold
    btnText.Parent = btn
    
    local statusDot = nil
    if hasDot then
        statusDot = Instance.new("Frame")
        statusDot.Size = UDim2.new(0, 10, 0, 10)
        statusDot.Position = UDim2.new(0.85, 0, 0.5, -5)
        statusDot.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        statusDot.BorderSizePixel = 0
        statusDot.Parent = btn
        local dotCorner = Instance.new("UICorner")
        dotCorner.CornerRadius = UDim.new(1, 0)
        dotCorner.Parent = statusDot
    end
    
    local dragging = false
    local dragStart
    local btnStartPos
    
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            btnStartPos = btn.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            local screenSize = game:GetService("GuiService"):GetScreenResolution()
            local newX = math.clamp(btnStartPos.X.Offset + delta.X, 0, screenSize.X - 140)
            local newY = math.clamp(btnStartPos.Y.Offset + delta.Y, 0, screenSize.Y - 50)
            btn.Position = UDim2.new(0, newX, 0, newY)
        end
    end)
    
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(160, 50, 255)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Transparency = 0.1, Thickness = 2}):Play()
    end)
    
    btn.MouseLeave:Connect(function()
        local isSpecial = false
        if name == "RightBtn" and patrolMode == "right" then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 40, 40)}):Play()
            isSpecial = true
        elseif name == "LeftBtn" and patrolMode == "left" then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 40, 40)}):Play()
            isSpecial = true
        elseif name == "FloatBtn" and floating then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 80, 40)}):Play()
            isSpecial = true
        elseif name == "InfJumpBtn" and infinityJumpEnabled then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 80, 40)}):Play()
            isSpecial = true
        elseif name == "LockBtn" and batAimbotEnabled then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 80, 40)}):Play()
            isSpecial = true
        elseif name == "AutoGrabBtn" and AutoGrabEnabled then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 80, 40)}):Play()
            isSpecial = true
        elseif name == "DropBtn" and dropEnabled then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 80, 40)}):Play()
            isSpecial = true
        end
        if not isSpecial then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = color or Color3.fromRGB(128, 0, 255)}):Play()
        end
        TweenService:Create(stroke, TweenInfo.new(0.2), {Transparency = 0.3, Thickness = 1.5}):Play()
    end)
    
    btn.MouseButton1Click:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.08), {BackgroundTransparency = 0.3}):Play()
        task.wait(0.08)
        TweenService:Create(btn, TweenInfo.new(0.08), {BackgroundTransparency = 0}):Play()
    end)
    
    return btn, gui, statusDot
end

