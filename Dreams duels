makeDraggable(batBtn)
makeDraggable(antiBtn)
makeDraggable(tpBtn)
makeDraggable(grabBtn)

-- ========== HOVER EFFECTS ==========
local function addHover(btn, isActive)
    btn.MouseEnter:Connect(function()
        ts:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(160, 50, 255)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        ts:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = isActive and Color3.fromRGB(128, 0, 255) or Color3.fromRGB(80, 0, 160)}):Play()
    end)
end

