    local InputCorner = Instance.new("UICorner")
    InputCorner.Parent = KeyInput
    InputCorner.CornerRadius = UDim.new(0, 8)
    
    local ActivateBtn = Instance.new("TextButton")
    ActivateBtn.Parent = MainFrame
    ActivateBtn.Position = UDim2.new(0.3, 0, 0.6, 0)
    ActivateBtn.Size = UDim2.new(0.4, 0, 0, 45)
    ActivateBtn.BackgroundColor3 = Color3.fromRGB(76, 175, 80)
    ActivateBtn.Font = Enum.Font.GothamBold
    ActivateBtn.Text = "ACTIVATE"
    ActivateBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ActivateBtn.TextSize = 16
    
    local BtnCorner = Instance.new("UICorner")
    BtnCorner.Parent = ActivateBtn
    BtnCorner.CornerRadius = UDim.new(0, 8)
    
    local Status = Instance.new("TextLabel")
    Status.Parent = MainFrame
    Status.Position = UDim2.new(0, 0, 0.8, 0)
    Status.Size = UDim2.new(1, 0, 0, 30)
    Status.BackgroundTransparency = 1
    Status.Font = Enum.Font.Gotham
    Status.Text = "Enter your key to activate"
    Status.TextColor3 = Color3.fromRGB(200, 200, 200)
    Status.TextSize = 12
    
    ActivateBtn.MouseButton1Click:Connect(function()
        local key = KeyInput.Text
        
        if key == "" then
            Status.Text = "❌ Please enter a key!"
            Status.TextColor3 = Color3.fromRGB(255, 100, 100)
            return
        end
        
        Status.Text = "⏳ Verifying..."
        Status.TextColor3 = Color3.fromRGB(255, 200, 100)
        ActivateBtn.Visible = false
        
        task.wait(1)
        
        if validKeys[key] then
            -- Save the key to their computer
            saveKey(key)
            
            Status.Text = "✅ Key saved! You won't need to enter it again."
            Status.TextColor3 = Color3.fromRGB(100, 255, 100)
            
            task.wait(1)
            ScreenGui:Destroy()
            loadFlingScript(key)
        else
            Status.Text = "❌ Invalid key!"
            Status.TextColor3 = Color3.fromRGB(255, 100, 100)
            ActivateBtn.Visible = true
            
            task.delay(2, function()
                Status.Text = "Enter your key to activate"
                Status.TextColor3 = Color3.fromRGB(200, 200, 200)
            end)
        end
    end)
end

-- MAIN - Check if key is already saved
local savedKey = loadSavedKey()

if savedKey and validKeys[savedKey] then
    -- Key is already saved and valid, load script immediately
    print("Found saved key! Loading script...")
    loadFlingScript(savedKey)
else
    -- No saved key or key is invalid, show entry GUI
    if savedKey and not validKeys[savedKey] then
        print("Saved key is invalid, clearing...")
        clearSavedKey()
    end
    createKeyGUI()
end
