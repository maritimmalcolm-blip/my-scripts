-- KEY SYSTEM - Remembers your key forever
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- VALID KEYS (from your Pastebin)
local validKeys = {
    ["DROP-F9X2K-7M4NQ"] = true,
    ["DROP-R3T8Y-2W6LP"] = true,
    ["DROP-K5Z9V-1C7XJ"] = true,
    ["DROP-G4H7M-8B2VN"] = true,
    ["DROP-J3S6Q-5D8PT"] = true,
    ["DROP-L2X9W-4F6HR"] = true,
    ["DROP-Z7V1C-9M3KB"] = true,
    ["DROP-Y8N4P-2R6TW"] = true,
}

-- Function to save key to their computer (stays forever)
local function saveKey(key)
    -- Saves to their Roblox account's settings
    pcall(function()
        player:SetAttribute("SavedKey", key)
    end)
end

-- Function to load saved key
local function loadSavedKey()
    local saved = player:GetAttribute("SavedKey")
    if saved and saved ~= "" then
        return saved
    end
    return nil
end

-- Function to clear saved key (optional, for debugging)
local function clearSavedKey()
    player:SetAttribute("SavedKey", nil)
end

-- FLING SCRIPT (loads when key is valid)
local function loadFlingScript(savedKey)
    print("🎉 FLING SCRIPT LOADED!")
    print("Using key: " .. savedKey)
    
    local RunService = game:GetService("RunService")
    local dropEnabled = false
    local _wfConns = {}
    
    local function toggleDrop(state)
        dropEnabled = state
        
        if dropEnabled then
            local colConn = RunService.Stepped:Connect(function()
                if not dropEnabled then return end
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= player and p.Character then
                        for _, part in ipairs(p.Character:GetChildren()) do
                            if part:IsA("BasePart") then 
                                part.CanCollide = false 
                            end
                        end
                    end
                end
            end)
            table.insert(_wfConns, colConn)
            
            task.spawn(function()
                while dropEnabled do
                    RunService.Heartbeat:Wait()
                    local c = player.Character
                    local root = c and c:FindFirstChild("HumanoidRootPart")
                    
                    if not root then continue end
                    
                    local vel = root.Velocity
                    root.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
                    
                    RunService.RenderStepped:Wait()
                    if root and root.Parent then root.Velocity = vel end
                    
                    RunService.Stepped:Wait()
                    if root and root.Parent then 
                        root.Velocity = vel + Vector3.new(0, 0.1, 0) 
                    end
                end
            end)
        else
            for _, c in ipairs(_wfConns) do
                if typeof(c) == "RBXScriptConnection" then c:Disconnect() end
            end
            _wfConns = {}
        end
    end
    
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Parent = player.PlayerGui
    ScreenGui.Name = "FlingGUI"
    
    local DropButton = Instance.new("TextButton")
    DropButton.Parent = ScreenGui
    DropButton.Size = UDim2.new(0, 150, 0, 50)
    DropButton.Position = UDim2.new(0.5, -75, 0.5, -25)
    DropButton.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    DropButton.Text = "DROP"
    DropButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    DropButton.Font = Enum.Font.GothamBold
    DropButton.TextSize = 18
    
    local Corner = Instance.new("UICorner")
    Corner.Parent = DropButton
    Corner.CornerRadius = UDim.new(0, 10)
    
    DropButton.MouseButton1Click:Connect(function()
        if not dropEnabled then
            toggleDrop(true)
            DropButton.Text = "ACTIVE!"
            DropButton.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
            
            task.delay(5, function()
                toggleDrop(false)
                DropButton.Text = "DROP"
                DropButton.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
            end)
        end
    end)
    
    -- Make button draggable
    local dragging = false
    local dragStart, startPos
    
    DropButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = DropButton.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            DropButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    print("✅ DROP button ready!")
end

