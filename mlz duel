-- ============ CREATE MOVEABLE BUTTON ============
local function createMoveableButton(name, text, startPos)
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = name .. "Button"
    ScreenGui.Parent = player.PlayerGui
    ScreenGui.ResetOnSpawn = false
    
    local button = Instance.new("TextButton")
    button.Parent = ScreenGui
    button.Size = UDim2.new(0, 130, 0, 40)
    button.Position = startPos
    button.BackgroundColor3 = Color3.fromRGB(0, 100, 255)
    button.BackgroundTransparency = 0.35
    button.Text = text
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 12
    button.AutoButtonColor = true
    button.BorderSizePixel = 0
    
    local corner = Instance.new("UICorner")
    corner.Parent = button
    corner.CornerRadius = UDim.new(0, 10)
    
    local uiStroke = Instance.new("UIStroke")
    uiStroke.Parent = button
    uiStroke.Thickness = 1
    uiStroke.Color = Color3.fromRGB(0, 150, 255)
    uiStroke.Transparency = 0.5
    
    local dragHandle = Instance.new("Frame")
    dragHandle.Parent = button
    dragHandle.Size = UDim2.new(1, 0, 0, 12)
    dragHandle.Position = UDim2.new(0, 0, 0, 0)
    dragHandle.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    dragHandle.BackgroundTransparency = 0.5
    dragHandle.BorderSizePixel = 0
    
    local handleCorner = Instance.new("UICorner")
    handleCorner.Parent = dragHandle
    handleCorner.CornerRadius = UDim.new(0, 10)
    
    local dots = Instance.new("TextLabel")
    dots.Parent = dragHandle
    dots.Size = UDim2.new(1, 0, 1, 0)
    dots.BackgroundTransparency = 1
    dots.Font = Enum.Font.GothamBold
    dots.Text = "⋮⋮"
    dots.TextColor3 = Color3.fromRGB(255, 255, 255)
    dots.TextSize = 10
    
    local dragging = false
    local dragStart
    local startPosUI
    
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            local pos = input.Position
            local absPos = button.AbsolutePosition
            if pos.Y - absPos.Y < 20 then
                dragging = true
                dragStart = input.Position
                startPosUI = button.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging then
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = input.Position - dragStart
                button.Position = UDim2.new(startPosUI.X.Scale, startPosUI.X.Offset + delta.X, startPosUI.Y.Scale, startPosUI.Y.Offset + delta.Y)
            end
        end
    end)
    
    return button
end

