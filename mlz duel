    rightBtn.Position = UDim2.new(0.075, 0, 0, 45)
    rightBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    rightBtn.Text = "AutoRight"
    rightBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    rightBtn.TextSize = 12
