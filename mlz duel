-- ============ FPS AND PING DISPLAY ============
local function createTopBar()
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "MLZDuels"
    ScreenGui.Parent = player.PlayerGui
    ScreenGui.ResetOnSpawn = false
    
    local TopBar = Instance.new("Frame")
    TopBar.Parent = ScreenGui
    TopBar.Size = UDim2.new(0, 200, 0, 25)
    TopBar.Position = UDim2.new(0.5, -100, 0, 5)
    TopBar.BackgroundColor3 = Color3.fromRGB(20, 20, 35)
    TopBar.BackgroundTransparency = 0.2
    TopBar.BorderSizePixel = 0
    
    local TopCorner = Instance.new("UICorner")
    TopCorner.Parent = TopBar
    TopCorner.CornerRadius = UDim.new(0, 8)
    
    local Title = Instance.new("TextLabel")
    Title.Parent = TopBar
    Title.Size = UDim2.new(0, 70, 1, 0)
    Title.Position = UDim2.new(0.05, 0, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Font = Enum.Font.GothamBold
    Title.Text = "MLZ DUELS"
    Title.TextColor3 = Color3.fromRGB(255, 200, 100)
    Title.TextSize = 11
    
    local FPSLabel = Instance.new("TextLabel")
    FPSLabel.Parent = TopBar
    FPSLabel.Size = UDim2.new(0, 50, 1, 0)
    FPSLabel.Position = UDim2.new(0.4, 0, 0, 0)
    FPSLabel.BackgroundTransparency = 1
    FPSLabel.Font = Enum.Font.GothamBold
    FPSLabel.Text = "FPS: --"
    FPSLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    FPSLabel.TextSize = 10
    
    local PingLabel = Instance.new("TextLabel")
    PingLabel.Parent = TopBar
    PingLabel.Size = UDim2.new(0, 55, 1, 0)
    PingLabel.Position = UDim2.new(0.65, 0, 0, 0)
    PingLabel.BackgroundTransparency = 1
    PingLabel.Font = Enum.Font.GothamBold
    PingLabel.Text = "Ping: --"
    PingLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
    PingLabel.TextSize = 10
    
    -- FPS Counter
    local frameCount = 0
    local lastTime = tick()
    
    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local currentTime = tick()
        if currentTime - lastTime >= 1 then
            FPSLabel.Text = "FPS: " .. frameCount
            frameCount = 0
            lastTime = currentTime
        end
    end)
    
    -- Fixed Ping Counter
    local function updatePing()
        local success, pingValue = pcall(function()
            local networkStats = Stats:FindFirstChild("Network")
            if networkStats then
                local pingStat = networkStats:FindFirstChild("Ping")
                if pingStat then
                    return math.floor(pingStat.Value)
                end
            end
            return nil
        end)
        
        if success and pingValue then
            PingLabel.Text = "Ping: " .. pingValue
            if pingValue <= 100 then
                PingLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            else
                PingLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
        end
    end
    
    task.spawn(function()
        while true do
            task.wait(1)
            updatePing()
        end
    end)
    
    updatePing()
end

createTopBar()

-- ============ INFINITE JUMP ============
RunService.Heartbeat:Connect(function()
    if not infinityJumpEnabled then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and hrp.Velocity.Y < -clampFallSpeed then
        hrp.Velocity = Vector3.new(hrp.Velocity.X, -clampFallSpeed, hrp.Velocity.Z)
    end
end)

UserInputService.JumpRequest:Connect(function()
    if not infinityJumpEnabled then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Velocity = Vector3.new(hrp.Velocity.X, jumpForce, hrp.Velocity.Z)
    end
end)

local function toggleInfiniteJump()
    infinityJumpEnabled = not infinityJumpEnabled
    return infinityJumpEnabled
end

